# AgencyDark Environment Configuration
# Copy this file to .env and update with your values

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agencydark
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# API Keys
INFLOW_API_KEY=your-inflow-api-key
ONLYFANS_API_KEY=your-onlyfans-api-key

# Frontend
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@agencydark.com

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# Rate Limiting
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# Backup (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=agencydark-backups