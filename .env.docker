# AgencyDark Docker Environment Configuration
# Uses host machine's PostgreSQL via host.docker.internal

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars

# Local PostgreSQL Database (accessed from Docker)
DATABASE_URL=postgresql://mariuszbudzisz@host.docker.internal:5432/agencydark_dev

# Database Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis (container)
REDIS_URL=redis://redis:6379/0
REDIS_TTL=3600

# API Keys (test values for local dev)
INFLOW_API_KEY=test-inflow-api-key
ONLYFANS_API_KEY=test-onlyfans-api-key

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Email (disabled for local)
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@localhost

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# Rate Limiting
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# Monitoring (disabled for local)
PROMETHEUS_ENABLED=false
SENTRY_DSN=

# AWS (disabled for local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_BACKUP_BUCKET=