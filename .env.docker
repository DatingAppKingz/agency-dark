# Application
APP_NAME=AgencyDark
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database - Using Docker PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/agencydark
DATABASE_SYNC_URL=postgresql://postgres:postgres@postgres:5432/agencydark
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agencydark
POSTGRES_PORT=5433

# Redis - Using Docker Redis with password
REDIS_URL=redis://:redis_password@redis:6379/0
REDIS_PASSWORD=redis_password
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=development_secret_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SECRET_KEY=development_secret_change_this

# CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# Email (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@agencydark.com

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Security
ALLOWED_HOSTS=localhost,127.0.0.1

# Docker
BACKEND_PORT=8000
WORKERS=4
VERSION=latest