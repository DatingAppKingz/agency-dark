# Database Configuration
DATABASE_URL=postgresql://agencydark:password@localhost:5432/agencydark_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Email (Optional for MVP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# External APIs (to be configured)
# INFLOW_API_URL=https://api.inflow.com
# INFLOW_API_KEY=your-inflow-api-key
# ONLYFANS_API_URL=https://onlyfansapi.com
# ONLYFANS_API_KEY=your-onlyfans-api-key

# Monitoring (Optional)
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_PORT=9090