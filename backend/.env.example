# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agencydark_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agencydark_dev
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_PORT=6379

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DELTA_SECONDS=86400
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Agency Dark
BACKEND_PORT=8000
WORKERS=4

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_CONCURRENCY=4

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAILS_FROM_EMAIL=noreply@agencydark.com
EMAILS_FROM_NAME=Agency Dark

# External APIs
ONLYFANS_API_URL=https://onlyfans.com/api2/v2
FANSLY_API_URL=https://apiv3.fansly.com/api/v1
INFLOW_API_URL=https://api.inflow.com
ENABLE_SYNC=true

# Storage Configuration
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,mp4,mov,pdf
STORAGE_BACKEND=local
# AWS S3 (Optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# Monitoring & Observability
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
OPENTELEMETRY_ENABLED=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# Payment Gateways
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=

# Feature Flags
FEATURE_WEBHOOKS_ENABLED=true
FEATURE_BULK_OPERATIONS_ENABLED=true
FEATURE_ML_INSIGHTS_ENABLED=true
FEATURE_ADVANCED_ANALYTICS_ENABLED=true

# OAuth2 Configuration
OAUTH_ISSUER=https://api.agencydark.com
OAUTH_ACCESS_TOKEN_LIFETIME=3600
OAUTH_REFRESH_TOKEN_LIFETIME=1209600
OAUTH_AUTHORIZATION_CODE_LIFETIME=600
OAUTH_REQUIRE_PKCE=true
OAUTH_ALLOW_PUBLIC_CLIENTS=true
OAUTH_REQUIRE_CONSENT=true
OAUTH_CONSENT_VALIDITY_DAYS=365
OAUTH_MAX_FAILED_ATTEMPTS=5
OAUTH_LOCKOUT_DURATION_MINUTES=30
OAUTH_TOKEN_SIGNING_ALGORITHM=RS256
OAUTH_USE_JWT_TOKENS=false
OAUTH_SESSION_COOKIE_SECURE=true
OAUTH_ENABLE_CROSS_AGENCY_ACCESS=false
OAUTH_AGENCY_ISOLATION_STRICT=true
OAUTH_EXTERNAL_PROVIDERS_ENABLED=google,instagram
OAUTH_ALLOW_INSECURE_HTTP=false
OAUTH_DEBUG_MODE=false

# External OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
ONLYFANS_CLIENT_ID=
ONLYFANS_CLIENT_SECRET=