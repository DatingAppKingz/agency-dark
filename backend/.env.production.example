# Production Environment Configuration
# Copy this file to .env.production and fill in your values

# Application
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-very-secure-secret-key-change-this
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
FRONTEND_URL=https://yourdomain.com
VERSION=1.0.0

# Database
DB_USER=agencydark
DB_PASSWORD=your-secure-database-password
DB_NAME=agencydark
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_TTL=3600
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# API Keys
INFLOW_API_KEY=your-inflow-api-key
ONLYFANS_API_KEY=your-onlyfans-api-key

# JWT/Authentication
JWT_SECRET=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-base64

# Email Configuration
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
HOSTNAME=production-backend

# Performance
WEB_CONCURRENCY=4
WORKER_CONNECTIONS=1000
MAX_REQUESTS=10000
MAX_REQUESTS_JITTER=1000

# Build Arguments
BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
VCS_REF=$(git rev-parse --short HEAD)

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# File Upload
MAX_UPLOAD_SIZE=104857600  # 100MB
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,gif,mp4,mov,pdf

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_BURST=20

# CORS
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# Session
SESSION_LIFETIME=86400  # 24 hours
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=strict

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_ML_FEATURES=true
ENABLE_REAL_TIME_MONITORING=true
ENABLE_CRYPTO_PAYMENTS=true

# ML Analytics
ML_MODEL_PATH=/app/ml_models
ML_UPDATE_INTERVAL=86400  # Daily
ML_MIN_TRAINING_SAMPLES=100

# Crypto Payments (if using Coinbase Commerce)
COINBASE_COMMERCE_API_KEY=your-coinbase-api-key
COINBASE_WEBHOOK_SECRET=your-webhook-secret

# Stripe (if using traditional payments)
STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# AWS (if using S3 for uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=agencydark-uploads

# Cloudflare (if using R2)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=agencydark-uploads

# Cache Settings
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=agencydark:

# Background Jobs
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2

# API Rate Limits (per minute)
API_RATE_LIMIT_ANONYMOUS=10
API_RATE_LIMIT_AUTHENTICATED=100
API_RATE_LIMIT_PREMIUM=1000

# Webhook Configuration
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=60
WEBHOOK_TIMEOUT=30

# Monitoring Alerts
ALERT_EMAIL=alerts@yourdomain.com
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=agencydark-backups

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net
CSP_STYLE_SRC='self' 'unsafe-inline' https://fonts.googleapis.com
CSP_FONT_SRC='self' https://fonts.gstatic.com
CSP_IMG_SRC='self' data: https:
CSP_CONNECT_SRC='self' wss://yourdomain.com https://api.yourdomain.com

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing scheduled maintenance.