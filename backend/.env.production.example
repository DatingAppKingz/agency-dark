# Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# ===== APPLICATION SETTINGS =====
ENVIRONMENT=production
APP_NAME=AgencyDark
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-this-to-a-very-secure-secret-key-min-32-chars
API_V1_STR=/api/v1

# ===== DATABASE CONFIGURATION =====
DATABASE_URL=postgresql+asyncpg://agencydark_user:your_secure_password@localhost:5432/agencydark_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false

# ===== REDIS CONFIGURATION =====
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password
REDIS_MAX_CONNECTIONS=50
REDIS_DECODE_RESPONSES=true

# ===== SECURITY SETTINGS =====
# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
BCRYPT_ROUNDS=12

# API Keys
API_KEY_LENGTH=32
API_KEY_PREFIX=ad_

# Session Management
SESSION_LIFETIME_SECONDS=3600
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# ===== CORS CONFIGURATION =====
CORS_ORIGINS=["https://app.agencydark.com","https://www.agencydark.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","PATCH","OPTIONS"]
CORS_ALLOW_HEADERS=["Content-Type","Authorization","X-Requested-With"]

# ===== EMAIL CONFIGURATION =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@agencydark.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_EMAIL=notifications@agencydark.com
EMAILS_FROM_NAME=AgencyDark
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAIL_TEMPLATES_DIR=email-templates

# ===== STORAGE CONFIGURATION =====
# S3/MinIO Configuration
S3_BUCKET_NAME=agencydark-media
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_USE_SSL=true
S3_VERIFY_SSL=true

# Local Storage (fallback)
UPLOAD_DIR=/opt/agencydark/uploads
MAX_UPLOAD_SIZE=104857600  # 100MB

# ===== MONITORING & LOGGING =====
# Sentry
SENTRY_DSN=https://your_key@sentry.io/project_id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/agencydark/app.log
LOG_FILE_MAX_BYTES=10485760  # 10MB
LOG_FILE_BACKUP_COUNT=5

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_BURST_SIZE=10

# ===== ONLYFANS INTEGRATION =====
ONLYFANS_API_BASE_URL=https://onlyfans.com/api2/v2
ONLYFANS_USER_AGENT=AgencyDark/1.0
ONLYFANS_TIMEOUT=30
ONLYFANS_MAX_RETRIES=3
ONLYFANS_WEBHOOK_SECRET=your_webhook_secret

# ===== CELERY CONFIGURATION =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600  # 1 hour
CELERY_TASK_SOFT_TIME_LIMIT=3300  # 55 minutes

# ===== MACHINE LEARNING =====
ML_MODEL_CACHE_TTL=3600
ML_ANOMALY_CONTAMINATION_RATE=0.01
ML_MIN_TRAINING_SAMPLES=100

# ===== PERFORMANCE =====
# Connection Pools
CONNECTION_POOL_SIZE=10
CONNECTION_POOL_MAX_OVERFLOW=20
CONNECTION_POOL_TIMEOUT=30

# Caching
CACHE_TTL_SHORT=300  # 5 minutes
CACHE_TTL_MEDIUM=3600  # 1 hour
CACHE_TTL_LONG=86400  # 24 hours

# ===== EXTERNAL SERVICES =====
# Payment Processing
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token

# ===== FEATURE FLAGS =====
FEATURE_BULK_OPERATIONS=true
FEATURE_ML_ANALYTICS=true
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_TWO_FACTOR_AUTH=true
FEATURE_API_VERSIONING=true

# ===== MISC SETTINGS =====
TIMEZONE=UTC
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=["en","es","fr","de"]
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System under maintenance. Please try again later."