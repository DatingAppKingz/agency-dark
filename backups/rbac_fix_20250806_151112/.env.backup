# AgencyDark Environment Configuration Template
# Copy this file to .env and update with your values

# === Core Configuration ===
ENVIRONMENT=production
DEBUG=false
VERSION=latest

# === Security ===
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_MIN_32_CHARS

# === Database Configuration ===
# For Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agencydark
POSTGRES_PORT=5433

# For Application
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/agencydark
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# === Redis Configuration ===
REDIS_PASSWORD=redis_password
REDIS_PORT=6379
REDIS_URL=redis://:redis_password@redis:6379/0
REDIS_TTL=3600

# === API Configuration ===
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=https://app.agencydark.com
ALLOWED_ORIGINS=https://app.agencydark.com,https://api.agencydark.com

# === External API Keys ===
# OpenAI for AI responses
OPENAI_API_KEY=sk-your-openai-api-key

# Payment Processing
STRIPE_API_KEY=sk_live_your-stripe-api-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Platform APIs
INFLOW_API_KEY=your-inflow-api-key
ONLYFANS_API_KEY=your-onlyfans-api-key

# === Email Configuration ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@agencydark.com
SMTP_USE_TLS=true

# === File Storage ===
UPLOAD_DIR=/app/uploads
EXPORT_DIR=/app/exports
MAX_UPLOAD_SIZE=52428800  # 50MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,mp4,pdf
EXPORT_RETENTION_DAYS=30

# === Performance ===
WORKERS=4
WORKER_CONNECTIONS=1000
KEEPALIVE=5

# === Rate Limiting ===
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_BURST=20

# === Session Configuration ===
SESSION_LIFETIME_HOURS=24
REFRESH_TOKEN_LIFETIME_DAYS=30
MAX_SESSIONS_PER_USER=5

# === Celery Configuration ===
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_WORKER_CONCURRENCY=4

# === Monitoring ===
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# === Feature Flags ===
ENABLE_MFA=true
ENABLE_WEBHOOKS=true
ENABLE_AI_RESPONSES=true
ENABLE_BULK_MESSAGING=true
ENABLE_SCHEDULED_REPORTS=true

# === Backup Configuration ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # 2 AM daily
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=agencydark-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# === Development Tools ===
# Only enable in development/staging
PGADMIN_EMAIL=admin@agencydark.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_PORT=5050

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/agencydark.log
LOG_MAX_SIZE=100M
LOG_BACKUP_COUNT=10